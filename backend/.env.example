# Salin file ini jadi .env lalu isi nilainya
PORT=3000
NODE_ENV=development

# Lokasi file database SQLite
DB_PATH=./data/warban.db

# WAJIB diisi untuk mengaktifkan endpoint /api/admin/* (pakai string acak panjang)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Origin frontend yang boleh akses API (pisahkan dengan koma). Kosongkan jika frontend
# disajikan oleh server ini sendiri (same-origin).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Nomor WhatsApp warung (format internasional tanpa +) untuk tombol "konfirmasi via WA"
WHATSAPP_NUMBER=628085410098

# Folder frontend yang disajikan (default: satu level di atas folder backend)
# STATIC_DIR=..
